{
  "name": "inkwell",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "dev:ws": "tsx server/ws-server.ts",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:ws\"",
    "build:ws": "tsc --outDir dist/server --module nodenext --moduleResolution nodenext --target es2022 --esModuleInterop --skipLibCheck server/ws-server.ts",
    "start:ws": "node dist/server/ws-server.js",
    "start:all": "concurrently \"npm run start\" \"npm run start:ws\""
  },
  "dependencies": {
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.100.1",
    "@tiptap/extension-code-block-lowlight": "^3.21.0",
    "@tiptap/extension-collaboration": "^3.21.0",
    "@tiptap/extension-collaboration-cursor": "^3.0.0",
    "@tiptap/extension-image": "^3.21.0",
    "@tiptap/extension-link": "^3.21.0",
    "@tiptap/extension-placeholder": "^3.21.0",
    "@tiptap/extension-underline": "^3.21.0",
    "@tiptap/pm": "^3.21.0",
    "@tiptap/react": "^3.21.0",
    "@tiptap/starter-kit": "^3.21.0",
    "@tiptap/y-tiptap": "^3.0.2",
    "dotenv": "^17.3.1",
    "groq-sdk": "^1.1.2",
    "lib0": "^0.2.117",
    "lowlight": "^3.3.0",
    "next": "16.2.1",
    "openai": "^6.33.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tippy.js": "^6.3.7",
    "y-prosemirror": "^1.3.7",
    "y-protocols": "^1.0.7",
    "ws": "^8.20.0",
    "y-websocket": "^3.0.0",
    "yjs": "^13.6.30",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
